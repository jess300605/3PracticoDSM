    <!-- Architecture & Info Dialog -->
    <string name="info_dialog_title">Acerca de AprendeApp</string>
    <string name="info_dialog_body">Desarrollado para el Tercer Desafío Práctico DSM en Universidad Don Bosco.\n\n• Arquitectura: MVC / MVVM con Kotlin y Jetpack Compose.\n• Consumo de API REST con Retrofit + OkHttp.\n• Autenticación con roles (Estudiante y Docente).\n• Validación robusta de contraseñas de 12+ caracteres.\n• Persistencia local de Favoritos con Room Database.\n• Sistema de calificación dinámico (1 a 5 estrellas) sincronizado con el backend.</string>
